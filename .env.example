# Postgres: the bundled container is created with these; URL-encode special characters in the password
POSTGRES_USER=subcult
POSTGRES_PASSWORD=
POSTGRES_DB=subcult
# Point at another server to use an external database
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Swarm: Bee node on the host, or any reachable Bee node
BEE_URL=http://host.docker.internal:1633
POSTAGE_BATCH_ID=

# Chain: shared Notify contract on Gnosis (livecoding.eth.limo)
CHAIN_RPC_URL=https://rpc.gnosischain.com
CHAIN_ID=100
CONTRACT_ADDRESS=0x5cDb55a64D5D5d8754398448D5a0e01098a57438
# Deployment block is 46507870; start near the current head to skip other apps' history
START_BLOCK=46507870
CONFIRMATIONS=2

# Chain: local Anvil (`--profile anvil`); account #0 deploys Notify at a fixed address
# CHAIN_RPC_URL=http://anvil:8545
# CHAIN_ID=31337
# CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# START_BLOCK=0
# CONFIRMATIONS=0
# OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Operator wallet that sends notify(swarmRef); needs xDAI on Gnosis
OPERATOR_PRIVATE_KEY=

# Comma-separated operator addresses whose events are indexed; empty = any sender
ALLOWED_SENDERS=

# Paid content: without MASTER_KEY this operator lists private parts but cannot sell them
# MASTER_KEY encrypts stored content keys at rest: openssl rand -hex 32
MASTER_KEY=
# This backend's public URL, recorded as keyHolder in private parts it sells
PUBLIC_URL=http://localhost:3000
# Payments: USDC and USDT on Ethereum mainnet (records stay on the chain above)
PAYMENT_CHAIN_ID=1
PAYMENT_RPC_URL=https://ethereum-rpc.publicnode.com
# An RPC endpoint browsers can reach to send payments; defaults to PAYMENT_RPC_URL
# PUBLIC_PAYMENT_RPC_URL=
PAYMENT_CONFIRMATIONS=3
# Underpayment accepted, in basis points of the price
PAYMENT_TOLERANCE_BPS=0
# Overrides the currency list (JSON: [{id, symbol, decimals, price, payable, rate: "fixed:<usd>"}]);
# the default prices in USD and accepts USDC and USDT on Ethereum mainnet
# CURRENCIES=
